# Production Environment Variables

# Database
POSTGRES_USER=marketing_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=marketing_prod

# Redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Application
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY
APP_ENV=production
DEBUG=false

# AI APIs
ANTHROPIC_API_KEY=your-production-anthropic-key
OPENAI_API_KEY=your-production-openai-key
REPLICATE_API_TOKEN=your-production-replicate-token

# Social Media APIs
META_APP_ID=your-production-meta-app-id
META_APP_SECRET=your-production-meta-app-secret
TWITTER_API_KEY=your-production-twitter-api-key
TWITTER_API_SECRET=your-production-twitter-api-secret
TWITTER_BEARER_TOKEN=your-production-twitter-bearer-token
LINKEDIN_CLIENT_ID=your-production-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-production-linkedin-client-secret

# Email
SENDGRID_API_KEY=your-production-sendgrid-key

# Payment
STRIPE_SECRET_KEY=your-production-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-production-stripe-webhook-secret

# Monitoring
SENTRY_DSN=your-production-sentry-dsn

# Frontend
API_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
